{
  "name": "dongtrieu-tourism",
  "version": "1.0.0",
  "private": true,
  "description": "Cổng thông tin du lịch phường Đông Triều — Quảng Ninh",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "extract": "npm --workspace server run extract",
    "fetch-images": "npm --workspace server run fetch-images",
    "import-images": "npm --workspace server run import-images",
    "test-chatbot": "npm --workspace server run test-chatbot",
    "test-scenarios": "npm --workspace server run test-scenarios",
    "test-scenarios-bulk": "npm --workspace server run test-scenarios-bulk",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:studio": "npm --workspace server run db:studio",
    "setup": "npm install && npm run extract && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.33.5": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true
  }
}
