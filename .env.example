# ─────────────────────────────────────────────────────────────
# Cổng thông tin du lịch phường Đông Triều
# Copy file này thành `.env` rồi điền giá trị thật.
# ─────────────────────────────────────────────────────────────

# --- Cơ sở dữ liệu (PostgreSQL 16) ---
# Cú pháp: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dongtrieu?schema=public"

# --- Máy chủ ---
PORT=4000
NODE_ENV=development
# URL công khai của site (dùng cho sitemap, thẻ Open Graph)
PUBLIC_SITE_URL="http://localhost:4000"

# --- Bảo mật ---
# BẮT BUỘC đổi khi lên production. Sinh chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi-chuoi-nay-truoc-khi-len-production"
# Trang quản trị giữ token trong bộ nhớ trình duyệt và mất khi tải lại trang,
# nên hạn này chỉ là chặn trên cho một buổi làm việc liên tục. Đừng đặt dài.
JWT_EXPIRES_IN="8h"
# Chỉ dùng khi chạy dev (client 5173 gọi sang server 4000)
CORS_ORIGIN="http://localhost:5173"

# --- Tài khoản admin khởi tạo (dùng bởi `npm run db:seed`) ---
# Tên đăng nhập có thể là tên ngắn ("admin") hoặc địa chỉ email — tuỳ bạn.
# ADMIN_PASSWORD BẮT BUỘC phải điền, tối thiểu 10 ký tự — không có giá trị mặc
# định, seed sẽ dừng nếu bỏ trống. Sinh mật khẩu mạnh:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="Quản trị viên"

# --- Toạ độ dự báo ---
# Trung tâm phường Đông Triều — dùng cho dự báo thời tiết
WEATHER_LAT=21.0433
WEATHER_LON=106.5544
# Cửa Nam Triệu – Bạch Đằng — điểm lưới hải văn gần nhất có dữ liệu triều.
# (Toạ độ Đông Triều nằm ngoài lưới marine của Open-Meteo nên trả về null)
TIDE_LAT=20.70
TIDE_LON=106.80

# --- Ảnh: Pexels API (tuỳ chọn) ---
# Lấy key miễn phí tại https://www.pexels.com/api/ rồi dán vào đây.
# Bỏ trống thì script tải ảnh sẽ tự dùng Wikimedia Commons.
PEXELS_API_KEY=""

# --- Upload ảnh ---
UPLOAD_MAX_MB=8
