// Khám phá Đông Triều — cổng thông tin du lịch phường Đông Triều, Quảng Ninh
// Nguồn dữ liệu: hồ sơ lý lịch di tích + QĐ xếp hạng (thư mục .docx gốc)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Người dùng ────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  /// Tên đăng nhập (có thể là tên ngắn như "admin" hoặc địa chỉ email)
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Di tích ───────────────────────────────────────────────────────────────

enum HeritageType {
  CHUA // Chùa
  DEN // Đền
  DINH // Đình
  MIEU // Miếu
  CUM_DI_TICH // Cụm đình – chùa – đền – nghè
  LICH_SU_CACH_MANG // Di tích lịch sử cách mạng
}

enum RankLevel {
  QUOC_GIA_DAC_BIET
  QUOC_GIA
  CAP_TINH
}

model Heritage {
  id   String @id @default(cuid())
  slug String @unique
  name String

  altNames String[] @default([])
  type     HeritageType
  typeText String? // nguyên văn trong hồ sơ, vd "Cụm di tích (đình – chùa – đền – nghè)"

  rankLevel     RankLevel
  rankLevelText String? // "Di tích quốc gia ĐẶC BIỆT"
  rankDecision  String? // "QĐ số 2383/QĐ-TTg ngày 09/12/2013"
  rankAuthority String? // "Thủ tướng Chính phủ"
  rankNote      String? // ghi chú bổ sung trong ngoặc

  address  String
  wardOld  String? // tên xã/phường cũ trước sáp nhập
  mapQuery String? // chuỗi tra Google Maps khi chưa có toạ độ
  lat      Float?
  lng      Float?
  /// true = toạ độ do script `npm run geocode` tự dò từ địa chỉ, CHƯA có người
  /// xác minh. Bản đồ số vẽ ghim này khác kiểu và khu quản trị hiện nhãn nhắc.
  /// Đặt tên theo tiền lệ `khuPhoEstimated` đã có trong file này.
  coordsEstimated Boolean @default(false)

  worship      String[] @default([]) // đối tượng thờ phụng
  festivalNote String? // mô tả lễ hội trong hồ sơ di tích
  keywords     String[] @default([])

  summary      String  @db.Text
  history      String  @db.Text
  architecture String  @db.Text
  highlights   String[] @default([])

  /// Cách đến và kinh nghiệm tham quan (Markdown)
  travelTips String? @db.Text

  coverUrl String?
  /// true = ảnh bìa chỉ mang tính minh hoạ, không phải ảnh chụp chính di tích này
  coverIsIllustrative Boolean @default(false)

  featured  Boolean @default(false)
  order     Int     @default(0)
  published Boolean @default(true)

  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images    Json       @default("[]")
  festivals Festival[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([type])
  @@index([rankLevel])
}

// ─── Lễ hội ────────────────────────────────────────────────────────────────

enum FestivalScale {
  LON // Lễ hội lớn cấp vùng
  VUA // Quy mô vừa
  HOI_LANG // Hội làng
}

model Festival {
  id   String @id @default(cuid())
  slug String @unique
  name String

  lunarMonth    Int? // tháng âm lịch bắt đầu (Giêng = 1, Chạp = 12)
  lunarDay      Int? // ngày âm lịch bắt đầu
  lunarTimeText String // nguyên văn, vd "13 – 17 tháng Giêng âm lịch"
  solarEstimate String? // "Khoảng tháng 2 dương lịch"

  location String
  scale    FestivalScale @default(HOI_LANG)
  /// Độ dài lễ hội theo hồ sơ, vd "3 ngày", "Gần 3 tháng"
  duration String?

  intro   String   @db.Text
  rituals String[] @default([])

  // ── Hồ sơ chi tiết (bộ dữ liệu lễ hội 2026) ──
  // Có đủ các trường này thì chatbot trả lời được "lễ hội thờ ai", "có nghi lễ
  // gì", "đi lễ hội cần lưu ý gì" thay vì chỉ đọc lại đoạn giới thiệu.

  /// Lịch sử hình thành lễ hội
  history String? @db.Text
  /// Nhân vật / vị thần được thờ
  worship String[] @default([])
  /// Ý nghĩa văn hoá
  meaningCultural String? @db.Text
  /// Ý nghĩa tâm linh
  meaningSpiritual String? @db.Text
  /// Hoạt động phần hội (thi đấu, văn nghệ, trò chơi dân gian)
  activities String[] @default([])
  /// Đối tượng tham gia
  participants String?
  /// Kinh nghiệm cho du khách (thời điểm đẹp, trang phục, lưu ý)
  visitorTips String[] @default([])
  /// Di tích liên quan (nguyên văn hồ sơ, có thể ngoài phường)
  heritageNote String?
  /// Ghi chú đơn vị hành chính mới sau sắp xếp 2025
  wardNote String? @db.Text
  /// Nguồn tham khảo của hồ sơ lễ hội
  sourceNote String?

  heritageId String?
  heritage   Heritage? @relation(fields: [heritageId], references: [id], onDelete: SetNull)

  coverUrl            String?
  coverIsIllustrative Boolean  @default(false)
  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images              Json     @default("[]")
  order               Int      @default(0)
  published           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, lunarMonth, lunarDay])
}

// ─── Lưu trú ───────────────────────────────────────────────────────────────

enum LodgingType {
  KHACH_SAN
  NHA_NGHI
  HOMESTAY
}

model Lodging {
  id      String      @id @default(cuid())
  name    String
  type    LodgingType @default(NHA_NGHI)
  address String
  owner   String?
  phones  String[]    @default([])

  lat         Float?
  lng         Float?
  /// true = toạ độ do script `npm run geocode` tự dò từ địa chỉ, CHƯA có người
  /// xác minh. Bản đồ số vẽ ghim này khác kiểu và khu quản trị hiện nhãn nhắc.
  /// Đặt tên theo tiền lệ `khuPhoEstimated` đã có trong file này.
  coordsEstimated Boolean @default(false)
  description String?  @db.Text
  priceRange  String?
  amenities   String[] @default([])
  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images      Json     @default("[]")

  /// Giờ nhận/trả phòng hoặc giờ mở cửa, vd "24 giờ"
  openHours String?

  /// Điểm sao trung bình trên Google Maps (0–5) và số lượt đánh giá.
  /// null = chưa có lượt đánh giá nào — KHÔNG phải 0 sao.
  rating      Float?
  ratingCount Int?

  /// Khu phố mới sau sắp xếp 2025 (1 trong 11 khu phố của phường).
  khuPho String?
  /// true = khu phố do suy luận từ tên đường/đơn vị cũ, chưa đối chiếu sơ đồ chính thức
  khuPhoEstimated Boolean @default(false)
  /// Khu vực hành chính, vd "Phường Bình Khê (lân cận)" cho cơ sở ngoài phường
  area String?

  /// Thẻ tìm kiếm ngữ nghĩa, vd "gần chợ Cột", "wifi", "khách nước ngoài"
  tags String[] @default([])

  placeId String? // Google Place ID
  mapsUrl String? // liên kết Google Maps

  /// true = có trong Danh sách cơ sở lưu trú của UBND phường 2026
  registeredWithWard Boolean @default(false)
  /// Nguồn của bản ghi, vd "Google Maps", "Danh sách UBND phường 2026"
  sourceNote String?

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ─── Ẩm thực ───────────────────────────────────────────────────────────────

model Cuisine {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  summary String @db.Text

  description String   @db.Text
  priceRange  String?
  season      String?
  whereToBuy  String[] @default([])

  coverUrl            String?
  coverIsIllustrative Boolean  @default(false)
  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images              Json     @default("[]")
  order               Int      @default(0)
  published           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

enum RestaurantType {
  NHA_HANG
  QUAN_AN
  CAFE
  DIEM_DUNG_CHAN
}

model Restaurant {
  id      String         @id @default(cuid())
  name    String
  type    RestaurantType @default(NHA_HANG)
  address String
  phone   String?

  openHours   String?
  priceRange  String?
  specialties String[] @default([])
  description String?  @db.Text

  lat    Float?
  lng    Float?
  /// true = toạ độ do script `npm run geocode` tự dò từ địa chỉ, CHƯA có người
  /// xác minh. Bản đồ số vẽ ghim này khác kiểu và khu quản trị hiện nhãn nhắc.
  /// Đặt tên theo tiền lệ `khuPhoEstimated` đã có trong file này.
  coordsEstimated Boolean @default(false)

  coverUrl            String?
  coverIsIllustrative Boolean  @default(false)
  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images              Json     @default("[]")

  /// Khu vực hành chính, vd "Phường Đông Triều" hoặc "Phường Mạo Khê (lân cận)".
  /// Cần thiết vì sau sáp nhập 2025, nhiều cơ sở nằm ở phường khác.
  area String?

  /// Điểm sao trung bình trên Google Maps (0–5) và số lượt đánh giá.
  /// null = chưa có lượt đánh giá nào — KHÔNG phải 0 sao.
  rating      Float?
  ratingCount Int?

  /// Khu phố mới sau sắp xếp 2025 (1 trong 11 khu phố của phường).
  khuPho String?
  /// true = khu phố do suy luận từ tên đường/toạ độ, chưa đối chiếu sơ đồ chính thức
  khuPhoEstimated Boolean @default(false)

  /// Thẻ tìm kiếm ngữ nghĩa, vd "view đẹp", "đỗ xe rộng", "ăn khuya"
  tags String[] @default([])

  placeId String? // Google Place ID
  mapsUrl String? // liên kết Google Maps

  /// Nguồn thông tin, vd "Tổng hợp từ Internet — chưa xác minh"
  sourceNote String?

  /// false = thông tin lấy từ Internet, chưa gọi kiểm chứng.
  /// Giao diện hiển thị nhãn cảnh báo cho tới khi quản trị viên bật cờ này.
  isVerified Boolean @default(false)

  /// true = dữ liệu mẫu do hồ sơ gốc không có danh sách nhà hàng.
  /// Quản trị viên thay bằng cơ sở thật rồi bỏ cờ này.
  isPlaceholder Boolean @default(false)

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ─── Điểm đến lân cận ──────────────────────────────────────────────────────
// Các điểm NGOÀI phường Đông Triều nhưng du khách thường kết hợp tham quan.
// Tách riêng khỏi Heritage để giữ đúng con số "13 cụm di tích đã xếp hạng
// của phường" theo hồ sơ chính thức.

enum AttractionType {
  TAM_LINH // chùa, đền, am
  LICH_SU // di tích lịch sử
  SINH_THAI // làng quê, sinh thái, trải nghiệm
}

model Attraction {
  id      String         @id @default(cuid())
  slug    String         @unique
  name    String
  type    AttractionType @default(TAM_LINH)

  /// Đơn vị hành chính chứa điểm này, vd "Xã An Sinh"
  ward       String?
  distanceKm Float?
  address    String?
  mapQuery   String?
  lat        Float?
  lng        Float?
  /// true = toạ độ do script `npm run geocode` tự dò từ địa chỉ, CHƯA có người
  /// xác minh. Bản đồ số vẽ ghim này khác kiểu và khu quản trị hiện nhãn nhắc.
  /// Đặt tên theo tiền lệ `khuPhoEstimated` đã có trong file này.
  coordsEstimated Boolean @default(false)

  summary     String  @db.Text
  description String? @db.Text
  highlights  String[] @default([])

  phone     String?
  openHours String?
  /// Điểm sao Google Maps (0–5) và số lượt đánh giá
  rating      Float?
  ratingCount Int?
  placeId     String?
  mapsUrl     String?
  tags        String[] @default([])

  coverUrl            String?
  coverIsIllustrative Boolean @default(false)
  /// Ảnh minh hoạ kèm chú thích: [{ url, caption }]. Xem lib/images.js.
  images              Json    @default("[]")

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ─── Bài viết / tin tức ────────────────────────────────────────────────────

enum ArticleCategory {
  TIN_TUC
  CAM_NANG
  PHONG_SU
  THONG_BAO
}

model Article {
  id      String          @id @default(cuid())
  slug    String          @unique
  title   String
  excerpt String          @db.Text
  contentHtml String      @db.Text
  category ArticleCategory @default(TIN_TUC)

  coverUrl String?
  author   String?
  tags     String[] @default([])
  views    Int      @default(0)

  publishedAt DateTime?
  published   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

// ─── Slider trang chủ ──────────────────────────────────────────────────────

model Slide {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String?
  /// Khi trống, giao diện dùng ảnh bìa placeholder theo di tích liên kết
  heritageSlug String?
  ctaLabel String?
  ctaHref  String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

// ─── Thư viện ảnh ──────────────────────────────────────────────────────────

model Media {
  id       String  @id @default(cuid())
  url      String
  thumbUrl String?
  filename String
  mime     String
  size     Int
  width    Int?
  height   Int?
  alt      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Cài đặt chung ─────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

// ─── Nhật ký chatbot ───────────────────────────────────────────────────────
// Ghi lại câu hỏi của du khách để quản trị viên biết bot còn THIẾU dữ liệu gì.
// Đây chính là vòng lặp "huấn luyện" của dự án: xem câu nào bot chịu thua
// (matched = false) rồi bổ sung nội dung tương ứng trong trang quản trị.
//
// Cố ý KHÔNG lưu IP, cookie hay bất cứ thứ gì nhận dạng người hỏi.

model ChatLog {
  id       String  @id @default(cuid())
  question String  @db.Text
  /// Ý định bot nhận ra, vd "weather_now", "lookup_heritage", "fallback"
  intent   String
  /// false = bot không tìm được thông tin phù hợp → cần bổ sung dữ liệu
  matched  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([matched, createdAt])
  @@index([createdAt])
}

// ─── Đánh giá của du khách ─────────────────────────────────────────────────
// KHÁC HẲN trường `rating`/`ratingCount` trên Lodging/Restaurant/Attraction:
// những trường đó là điểm sao **lấy từ Google Maps**, còn bảng này là đánh giá
// do khách gửi trên cổng. Hai con số không bao giờ được cộng gộp thành một điểm
// trung bình — nguồn khác nhau, cỡ mẫu khác nhau, và trộn vào là bịa số liệu.

enum ReviewTarget {
  HERITAGE
  FESTIVAL
  CUISINE
  LODGING
  RESTAURANT
  ATTRACTION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id String @id @default(cuid())

  targetType ReviewTarget
  /// LUÔN là `id` của bản ghi đích, không phải slug.
  ///
  /// Hai lý do: (1) Lodging và Restaurant không có slug; (2) slug sửa được trong
  /// khu quản trị, nên lưu theo slug là mọi đánh giá của một di tích sẽ mồ côi
  /// ngay lần đầu ai đó sửa đường dẫn. Không đặt được khoá ngoại vì đích thuộc
  /// sáu bảng khác nhau — bù lại, xoá bản ghi đích thì xoá luôn đánh giá của nó
  /// (xem `deleteReviewsOfTarget` trong services/reviews.js).
  targetId   String

  authorName String
  /// 1..5 — kiểm ở lớp zod. Không có 0 sao: "chưa đánh giá" là không có bản ghi.
  rating     Int
  /// Văn bản THUẦN. Hiển thị bằng văn bản thuần, không đi qua
  /// dangerouslySetInnerHTML, nên không cần lọc HTML ở đây.
  comment    String @db.Text

  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  /// Lúc quản trị viên duyệt hoặc từ chối.
  handledAt DateTime?

  @@index([targetType, targetId, status])
  @@index([status, createdAt])
}

// ─── Liên hệ / góp ý ───────────────────────────────────────────────────────
// Cố ý KHÔNG lưu IP hay bất cứ thứ gì nhận dạng người gửi ngoài thông tin họ
// chủ động điền, theo đúng lối đã chọn ở ChatLog. Giới hạn tần suất chống spam
// chỉ giữ IP trong bộ nhớ tiến trình, không ghi xuống cơ sở dữ liệu.

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String?
  phone   String?
  subject String?
  message String  @db.Text

  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  handledAt DateTime?

  @@index([handled, createdAt])
}
